{
  "realm": "openbook",
  "enabled": true,
  "displayName": "Openbook",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 1800,
  "roles": {
    "realm": [
      { "name": "openbook-user",  "description": "Ask questions and upload documents" },
      { "name": "openbook-admin", "description": "Ingestion jobs, re-indexing and retrieval metrics" }
    ]
  },
  "clients": [
    {
      "clientId": "openbook-frontend",
      "name": "Openbook Web Console",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:4173/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:4173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*##http://localhost:4173/*"
      },
      "protocolMappers": [
        {
          "name": "tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant",
            "claim.name": "tenant",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "openbook-frontend",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "email": "admin@openbook.local",
      "firstName": "Ada",
      "lastName": "Admin",
      "attributes": { "tenant": ["acme"] },
      "credentials": [ { "type": "password", "value": "admin", "temporary": false } ],
      "realmRoles": [ "openbook-user", "openbook-admin" ]
    },
    {
      "username": "user",
      "enabled": true,
      "emailVerified": true,
      "email": "user@openbook.local",
      "firstName": "Uma",
      "lastName": "User",
      "attributes": { "tenant": ["acme"] },
      "credentials": [ { "type": "password", "value": "user", "temporary": false } ],
      "realmRoles": [ "openbook-user" ]
    },
    {
      "username": "other",
      "enabled": true,
      "emailVerified": true,
      "email": "other@openbook.local",
      "firstName": "Otto",
      "lastName": "Othertenant",
      "attributes": { "tenant": ["globex"] },
      "credentials": [ { "type": "password", "value": "other", "temporary": false } ],
      "realmRoles": [ "openbook-user", "openbook-admin" ]
    }
  ]
}
